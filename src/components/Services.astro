---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    icon: "📡",
    title: "DStv Installation",
    description:
      "Professional decoder, satellite dish and cabling installations for homes and businesses."
  },
  {
    icon: "🔧",
    title: "Repairs & Signal",
    description:
      "Experiencing signal problems? We diagnose and repair faulty dishes, cables and connections."
  },
  {
    icon: "📺",
    title: "Decoder Upgrades",
    description:
      "Upgrade your existing DStv setup to a newer decoder or compatible installation."
  },
  {
    icon: "🏠",
    title: "Extra View",
    description:
      "Professional ExtraView installation for customers who want DStv in multiple rooms."
  }
];
---

<section class="section services-section" id="services">

  <div class="container">

    <div class="section-heading centered">

      <span class="eyebrow">
        What we do
      </span>

      <h2>
        DStv services you can
        <span>depend on.</span>
      </h2>

      <p>
        From new installations to repairs and upgrades, AVO Projects
        provides professional DStv solutions.
      </p>

    </div>

    <div class="services-grid">

      {
        services.map((service) => (
          <ServiceCard {...service} />
        ))
      }

    </div>

  </div>

</section>