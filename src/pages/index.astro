---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Packages from "../components/Packages.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="AVO Projects | DStv Installation Packages">
  <Header />

  <main>
    <section class="intro">
      <div class="container">
        <span class="intro-badge">ACCREDITED DSTV INSTALLER</span>

        <h1>
          Choose your
          <span>DStv package.</span>
        </h1>

        <p>
          Select what you need and book your installation.
        </p>
      </div>
    </section>

    <Packages />
  </main>

  <Footer />
</Layout>